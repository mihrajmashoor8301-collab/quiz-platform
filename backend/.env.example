# Backend config (env vars)
# Copy to `backend/.env.local` and adjust.

# Local PostgreSQL cluster (see README dev section).
DB_HOST=/home/mihraj/quiz-platform/sockdir
DB_PORT=5432
DB_NAME=quiz_app
DB_USER=quiz_app
DB_PASSWORD=quiz_app_password

# PostgreSQLs command is used by the db init script to apply the schema.
# It must match DB_USER / DB_HOST so trust auth succeeds without a password.
PGHOST=/home/mihraj/quiz-platform/sockdir
PGUSER=quiz_app

# HTTP server.
HTTP_PORT=3000
HTTP_HOST=0.0.0.0

# Origin(s) allowed to reach the API and the Socket.IO connection.
ALLOWED_ENV=https://localhost:3000,http://localhost:3000

# Round-trip latency of the process-local PostgreSQL cluster, used to
# size the question close window (submission ACK + last-answer margin).
ROUND_TRIP_MS=2

# Supabase integration points (unused by the local-first backend).
SUPABASE_PROJECT_ID=
SUPABASE_URL=http://localhost:9998
SUPABASE_ANON_KEY=placeholder-not-a-secret
