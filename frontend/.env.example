# Frontend config (env vars)
# Copy to `frontend/.env.local` and adjust.
# VITE_ prefix is read by the client at build time.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=http://localhost:9998
VITE_ANON_KEY=placeholder-not-a-secret
# Point to the backend (matches docker-compose service name when dockers are used).
VITE_BACKEND_URL=http://localhost:3000
