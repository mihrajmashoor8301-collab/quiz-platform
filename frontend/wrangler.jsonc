{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "quiz-platform-cloudflare",
  "main": "worker.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/room/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "QuizRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["QuizRoom"] }
  ],
  "vars": {
    "APP_ENV": "production"
  }
}
